# CI ל-coffee-break-api: lint ואז בדיקות על כמה גרסאות Node
name: CI

# טריגרים: push ל-main, כל PR, והרצה ידנית מה-UI
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

# הרשאות מינימליות: קריאה בלבד לקוד
permissions:
  contents: read

# מבטל ריצה קודמת על אותו branch/PR כשמגיע commit חדש
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # job ראשון: בדיקת סגנון קוד עם ESLint
  lint:
    runs-on: ubuntu-latest
    steps:
      # שליפת הקוד
      - uses: actions/checkout@v5

      # התקנת Node 22 + cache של npm לפי package-lock.json
      - uses: actions/setup-node@v5
        with:
          node-version: 22
          cache: npm

      # התקנה נקייה ושחזורית לפי ה-lockfile
      - run: npm ci

      # הרצת ה-linter
      - run: npm run lint

  # job שני: בדיקות, רץ רק אחרי ש-lint עבר
  test:
    needs: lint
    runs-on: ubuntu-latest

    # matrix על Node 22 ו-24; fail-fast כבוי כדי לראות תוצאות של שתי הגרסאות
    strategy:
      fail-fast: false
      matrix:
        node-version: [22, 24]

    steps:
      # שליפת הקוד
      - uses: actions/checkout@v5

      # התקנת גרסת ה-Node מה-matrix + cache של npm
      - uses: actions/setup-node@v5
        with:
          node-version: ${{ matrix.node-version }}
          cache: npm

      # התקנה נקייה לפי ה-lockfile
      - run: npm ci

      # הרצת הבדיקות (pretest:ci יוצר את reports/ אוטומטית, נכתב junit.xml)
      - run: npm run test:ci

      # העלאת reports/ כ-artifact גם אם הבדיקות נכשלו; שם ייחודי לכל גרסת Node
      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-reports-node-${{ matrix.node-version }}
          path: reports/
          if-no-files-found: warn
          retention-days: 7
